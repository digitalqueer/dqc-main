# Cloudflare Turnstile protects the contact form; without the site key the
# form is switched off. These are Cloudflare's test keys (always pass); use
# the keys from your Turnstile widget in production. The site key is read by
# the server at request time and handed to the page, so set both wherever the
# server runs.
VITE_CLOUDFLARE_SITEKEY=1x00000000000000000000AA
CLOUDFLARE_SECRET_KEY=1x0000000000000000000000000000000AA

# Resend: people who opt in to communications on the contact form are added
# as contacts. Needed for that opt-in to work.
RESEND_SECRET_KEY=

# Server Environment
# `docker compose up` sets DATABASE_URL itself; this one is for running the
# dev server on the host against `docker compose up postgres`.
DATABASE_URL=postgresql://dqc:dqc@localhost:5432/dqc
# The public origin. Session cookies and the OAuth redirect URI are built from it.
BETTER_AUTH_URL=http://localhost:3000
# A long random value, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=betterauthsecretvalue

# DQC's sign-in service: the dqc-main application's client and endpoints.
# Its redirect URIs need {BETTER_AUTH_URL}/api/auth/callback/dqc.
DQC_AUTHORIZE_URL=auth-server.url/application/o/authorize/
DQC_CLIENT_ID=provider_client_id
DQC_CLIENT_SECRET=provider_secret_key
DQC_END_SESSION_URL=auth-server.url/application/o/application_id/end-session/
DQC_TOKEN_URL=auth-server.url/application/o/token/
DQC_USER_INFO_URL=auth-server.url/application/o/userinfo/
